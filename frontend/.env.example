# Frontend env (copy to .env to override). Never commit real secrets.
# Default (empty/unset) = same-origin relative /api calls, which works with
# the Vite dev proxy (vite.config.js) and the Vercel /api rewrite.
# Only set an absolute URL for split-domain local dev, e.g.:
# VITE_API_URL=http://127.0.0.1:8000
VITE_API_URL=
