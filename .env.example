APP_NAME=AI-Driven Multi-Vendor Network Security Compliance Auditor
APP_ENV=development

# PostgreSQL ONLY (no SQLite anywhere). Copy to .env and fill real values.
# Local example:
#   DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/network_security_auditor
# Tests use a SEPARATE database (never the dev database):
#   DATABASE_URL_TEST=postgresql+psycopg://postgres:PASSWORD@localhost:5432/network_security_auditor_test
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL_TEST=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE_TEST

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Frontend API base. "/api" = same-origin (Vercel rewrites + Vite dev proxy).
# Only override for split-domain local dev, e.g. VITE_API_URL=http://127.0.0.1:8000
VITE_API_URL=/api

# Extra CORS origins (comma-separated). Needed only if the frontend is served
# from a different domain than the backend. Same-origin deploys need nothing.
# CORS_ORIGINS=https://app.example.com
